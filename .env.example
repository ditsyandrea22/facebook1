# GoRouter Anthropic gateway
ANTHROPIC_AUTH_TOKEN=isi-key-gateway-kamu-di-sini
ANTHROPIC_BASE_URL=https://gorouter.app
CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
ANTHROPIC_MODEL=claude-opus-4-8

# Telegram Bot (dapatkan dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=isi-token-bot-telegram-di-sini

# Bahasa output AI (id = Indonesia, en = English)
POST_LANG=id
